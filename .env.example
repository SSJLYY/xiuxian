# xiuxian-game 环境变量配置示例
# 复制此文件为 .env 并填入真实的密钥值
# 警告：.env 文件包含敏感信息，切勿提交到 Git 仓库！

# ==================== 数据库配置 ====================
# MySQL root 用户密码
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=你的强密码_至少 16 位_包含大小写字母数字特殊字符

# MySQL 应用用户密码
MYSQL_PASSWORD=你的强密码_至少 16 位_包含大小写字母数字特殊字符

# ==================== Redis 配置 ====================
# Redis 密码
REDIS_PASSWORD=你的强密码_至少 16 位_包含大小写字母数字特殊字符

# ==================== JWT 配置 ====================
# JWT 密钥 - 建议 32 位以上随机字符串
JWT_SECRET=你的超长随机密钥_至少 32 位_包含大小写字母数字特殊字符

# JWT 过期时间（毫秒）
JWT_EXPIRATION=86400000

# ==================== 管理员配置 ====================
# 管理员初始密码（BCrypt 哈希值，可使用在线工具生成）
# 原始密码建议：admin123 或更复杂的密码
ADMIN_PASSWORD=$2b$10$dd5hCl9Jc05iS4T05pNDPe4Dx3l8Vhnz4l3u/bJ1I0G9nFZs//F7C

# ==================== 数据库主从配置（可选） ====================
# 主库密码（读写分离）
DB_MASTER_PASSWORD=你的强密码_至少 16 位_包含大小写字母数字特殊字符

# 从库密码（读写分离）
DB_SLAVE_PASSWORD=你的强密码_至少 16 位_包含大小写字母数字特殊字符

# ==================== 其他配置 ====================
# CORS 允许的来源（生产环境请指定具体域名）
CORS_ALLOWED_ORIGINS=https://你的正式域名.com

# 日志级别
LOGGING_LEVEL_COM_XIUXIAN_GAME=INFO

# 服务器端口
SERVER_PORT=8081

# 运行环境
SPRING_PROFILES_ACTIVE=prod

# ==================== 安全提示 ====================
# 1. 生产环境必须使用强密码（至少 16 位，包含大小写字母、数字、特殊字符）
# 2. 定期更换密钥（建议每季度）
# 3. 不要将 .env 文件提交到 Git 仓库
# 4. 可以使用密码生成器生成随机密钥
# 5. 推荐使用密钥管理服务（如 AWS Secrets Manager、HashiCorp Vault）
