# ====================================================================
# 修仙挂机游戏 - 应用配置文件 (YAML格式)
# ====================================================================

# 服务器配置
server:
  port: 8081
  address: 0.0.0.0
  servlet:
    context-path: /
    encoding:
      charset: UTF-8
      enabled: true
      force: true

# 数据库配置
spring:
  datasource:
    url: jdbc:mysql://47.103.87.55:3306/xiuxian_game?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password: "vA8!zLd2#pFqR6$sXkNg9@bYwTmC3*eH"
    
    # HikariCP数据库连接池配置
    hikari:
      connection-timeout: 60000
      maximum-pool-size: 20
      minimum-idle: 5
      idle-timeout: 300000
      max-lifetime: 1800000
      pool-name: XiuxianGameHikariCP

  # 文件上传配置
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB
      enabled: true

  # 静态资源配置
  web:
    resources:
      static-locations: classpath:/static/,classpath:/public/,classpath:/META-INF/resources/
      add-mappings: true
      cache:
        period: 3600

  # 管理员配置
  security:
    user:
      name: admin
      password: password

# MyBatis-Plus配置
mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.xiuxian.game.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT配置
jwt:
  secret: xiuxianGameSecretKey2024VeryLongAndSecure
  expiration: 86400000

# Log4j2日志配置
logging:
  config: classpath:log4j2-spring.xml
  file:
    path: logs

# CORS跨域配置
app:
  cors:
    allowed-origins: "*"
    allowed-methods: GET,POST,PUT,DELETE,OPTIONS
    allowed-headers: "*"
    allow-credentials: true

  # 功能开关：所有模块启用（已迁移到MyBatis Plus）
  features:
    skills:
      enabled: true
    inventory:
      enabled: true
    quests:
      enabled: true
    equipment:
      enabled: true
    shop:
      enabled: true
    offline:
      enabled: true
    player-query:
      enabled: true

  # 游戏配置
  game:
    max-level: 9999
    max-offline-hours: 24
    cultivation:
      base-exp: 10
      max-time-hours: 24
    battle:
      max-batch-size: 100

# 性能监控配置
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: when-authorized
  metrics:
    export:
      simple:
        enabled: true